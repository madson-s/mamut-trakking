# Redirects de mamut.agency → mamuttrakking.com
# Slugs conferidos contra src/lib/routes.ts. Substitui o .htaccess do WordPress:
# guarde uma cópia do atual antes de trocar. Servidor: LiteSpeed (Hostinger).
#
# Ordem: 410 para consultas do WordPress → 301 explícitos (lista branca) →
# 410 para todo o resto: posts de spam da invasão, wp-admin, wp-json,
# xmlrpc.php, feeds, tags e uploads que não foram migrados.
# A query string é repassada (mantém utm_*). Destinos sem barra final,
# que é o formato canônico do site novo — evita um segundo salto.

Options -Indexes
RewriteEngine On

# --- Consultas do WordPress (?p=, ?s=, ?rest_route=…) saem do ar (410) ---
RewriteCond %{QUERY_STRING} (^|&)(s|p|page_id|cat|tag|attachment_id|feed|author|rest_route)= [NC]
RewriteRule ^ - [G]

# --- 301 explícitos ---
RewriteRule ^$ https://mamuttrakking.com/pt [R=301,L,NC]
RewriteRule ^aventuras/?$ https://mamuttrakking.com/pt/aventuras [R=301,L,NC]
RewriteRule ^aventuras/cachoeira-do-palmital/?$ https://mamuttrakking.com/pt/aventuras/cachoeira-do-palmital [R=301,L,NC]
RewriteRule ^aventuras/trilha-aguas-claras-2-dias/?$ https://mamuttrakking.com/pt/aventuras/trilha-aguas-claras-2-dias [R=301,L,NC]
